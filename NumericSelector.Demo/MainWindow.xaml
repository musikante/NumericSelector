<Window x:Class="NumericSelector.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NumericSelector;assembly=NumericSelector"
        xmlns:test="clr-namespace:NumericSelector.Demo"
        Title="BoundedNumericSelector - Demonstration &amp; Test Environment"
        Height="770"
        Width="880"
        WindowStartupLocation="CenterScreen">

    <!-- F1 opens the help: ApplicationCommands.Help already brings that gesture out of the
         box, so binding it is enough and the key needs declaring nowhere. -->
    <Window.CommandBindings>
        <CommandBinding Command="Help" Executed="Help_Executed"/>
    </Window.CommandBindings>

    <Window.Resources>
        <test:ThicknessToIntConverter x:Key="ThickToInt"/>
        <test:ColorIndexConverter x:Key="ColorIndex"/>
        <test:MouseBehaviorIndexConverter x:Key="MouseBehaviorIndex"/>
        <test:MouseBehaviorTextConverter x:Key="MouseBehaviorText"/>
        <test:InteractionModeIndexConverter x:Key="InteractionModeIndex"/>
        <test:InteractionModeTextConverter x:Key="InteractionModeText"/>
        <test:ValueBoxDockIndexConverter x:Key="ValueBoxDockIndex"/>
        <test:ValueBoxDockTextConverter x:Key="ValueBoxDockText"/>
        <!-- A single BoolIndex for both boolean properties: the conversion is the same one.
             What differs between them is the text, and that does get a converter per property. -->
        <test:BoolIndexConverter x:Key="BoolIndex"/>
        <test:ValueFollowsDetailTextConverter x:Key="ValueFollowsDetailText"/>
        <test:ShowDetailTextConverter x:Key="ShowDetailText"/>
        <test:FontIndexConverter x:Key="FontIndex"/>
        <test:FontStyleIndexConverter x:Key="FontStyleIndex"/>
        <test:FontWeightIndexConverter x:Key="FontWeightIndex"/>

        <!-- No resource for colors or fonts: the palette lives in ColorIndexConverter.Palette
             and the fonts are enumerated at runtime (FontIndexConverter). The pickers are
             numeric selectors working by index, so there is no list to declare in XAML. -->

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Section">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
            <Setter Property="Foreground" Value="#FF20507A"/>
        </Style>
        <!-- The auxiliary selectors: single line and of a uniform base width.
             BaseWidth is a floor they grow from to fit their text; if the container does not
             give them that room, MainText is truncated with an ellipsis. -->
        <Style TargetType="{x:Type local:BoundedNumericSelector}" x:Key="Auxiliary">
            <Setter Property="BaseWidth" Value="240"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox" x:Key="Box">
            <Setter Property="Width" Value="240"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Double-spaced variants of the styles above, used by the left and middle columns
             only. The right column keeps the tight spacing, so the difference is visible
             side by side. Every vertical margin is exactly twice the base one.
             "Label" has no spaced variant on purpose: it is the caption of the text box
             right below it, and the two have to read as one unit. Widening that gap as much
             as the gap BETWEEN pairs would leave each caption floating between both boxes. -->
        <Style TargetType="TextBlock" x:Key="SectionSpaced" BasedOn="{StaticResource Section}">
            <Setter Property="Margin" Value="0,24,0,12"/>
        </Style>
        <Style TargetType="{x:Type local:BoundedNumericSelector}" x:Key="AuxiliarySpaced" BasedOn="{StaticResource Auxiliary}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="TextBox" x:Key="BoxSpaced" BasedOn="{StaticResource Box}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ THE SUBJECT UNDER TEST (Master) ============ -->
        <Border Grid.Row="0" Margin="0,0,0,12"
                BorderBrush="#FFBFD4E6" BorderThickness="1"
                Background="#FFF6FAFD"
                Padding="5">
            <!-- The two texts of the Master are written this way ON PURPOSE; do not
                 "normalize" them:
                 • they start with the exact name of the property, so that it reads just as it
                   is typed in code;
                 • "(Interact here)" invites interaction with this area, which is the demo's
                   subject under test;
                 • "(Vertical extremes: jÑ)" are visual control characters: the j drops below
                   the line and the Ñ rises with its diacritic, so between the two they take up
                   the whole height of the line and it shows at once whether the text is being
                   clipped at the top or the bottom when the font or the size changes.
                 The label above only identifies the area; the invitation is not duplicated. -->
            <Grid>
                <TextBlock Text="Master"
                           VerticalAlignment="Top" HorizontalAlignment="Center"
                           FontWeight="Bold" Foreground="#FF20507A"/>
                <local:BoundedNumericSelector x:Name="MasterNumericSelector"
                                          ValueChanged="Master_ValueChanged"
                                          ShowDetail="True"
                                          MainText="MainText (Interact here)"
                                          DetailText="DetailText (Vertical extremes: jÑ)"
                                          Minimum="0"
                                          Maximum="100"
                                          Value="50"
                                          ResetValue="50"
                                          BorderThickness="2"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ============ THE TEST CONTROLS ============ -->
        <!-- It lives in a ScrollViewer: besides fitting everything in, it is what proves that
             the mouse wheel over an unfocused selector does NOT swallow the scroll.
             The window height (770) comes from measuring, not from taste. Two floors have to
             be cleared, and the taller one wins:
               • the left column, the tallest of the three since its spacing was doubled, needs
                 761 px with the default font — below that the scrollbar shows up on startup;
               • the FontFamily picker applies the chosen font to itself, so the tallest font
                 on this machine stretches the right column; that case was what asked for the
                 previous height.
             The few px of slack are deliberate: at the exact floor, any larger system font
             would bring the scrollbar back the moment the window opens. -->

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- === Column A: value, interaction and texts === -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">

                    <TextBlock Text="Value &amp; range" Style="{StaticResource SectionSpaced}" Margin="0,12,0,12"/>

                    <local:BoundedNumericSelector Style="{StaticResource AuxiliarySpaced}" MainText="Value"
                        Minimum="{Binding Minimum, ElementName=MasterNumericSelector}"
                        Maximum="{Binding Maximum, ElementName=MasterNumericSelector}"
                        Value="{Binding Value, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector Style="{StaticResource AuxiliarySpaced}" MainText="Minimum"
                        Minimum="-1000" Maximum="999"
                        Value="{Binding Minimum, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector Style="{StaticResource AuxiliarySpaced}" MainText="Maximum"
                        Minimum="-999" Maximum="1000"
                        Value="{Binding Maximum, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector Style="{StaticResource AuxiliarySpaced}" MainText="ResetValue"
                        Minimum="{Binding Minimum, ElementName=MasterNumericSelector}"
                        Maximum="{Binding Maximum, ElementName=MasterNumericSelector}"
                        Value="{Binding ResetValue, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector Style="{StaticResource AuxiliarySpaced}" MainText="SmallChange"
                        Minimum="1" Maximum="50"
                        Value="{Binding SmallChange, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector Style="{StaticResource AuxiliarySpaced}" MainText="LargeChange"
                        Minimum="1" Maximum="100"
                        Value="{Binding LargeChange, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <TextBlock Text="Interaction properties" Style="{StaticResource SectionSpaced}"/>

                    <!-- MouseBehavior driven with a numeric selector (0 = ChangeOnClick,
                         1 = MustFocusFirst), two-way with the Master. -->
                    <local:BoundedNumericSelector Style="{StaticResource AuxiliarySpaced}"
                                                  ShowDetail="True"
                                                  MainText="MouseBehavior"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource MouseBehaviorText}, Mode=OneWay}"
                                                  Minimum="0" Maximum="1"
                                                  Value="{Binding MouseBehavior, ElementName=MasterNumericSelector, Mode=TwoWay, Converter={StaticResource MouseBehaviorIndex}}"/>

                    <!-- InteractionMode driven with a numeric selector (0 = Interactive,
                         1 = ReadOnly), two-way with the Master. In ReadOnly the control keeps
                         its appearance but responds to neither mouse nor keyboard. -->
                    <local:BoundedNumericSelector Style="{StaticResource AuxiliarySpaced}"
                                                  ShowDetail="True"
                                                  MainText="InteractionMode"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource InteractionModeText}, Mode=OneWay}"
                                                  Minimum="0" Maximum="1"
                                                  Value="{Binding InteractionMode, ElementName=MasterNumericSelector, Mode=TwoWay, Converter={StaticResource InteractionModeIndex}}"/>

                    <!-- "Default texts": the texts the Master starts out with. Typing in the
                         boxes replaces them.
                         IT GOES LAST ON PURPOSE: the label of the DetailText box refers to
                         ShowDetail, which lives under "Disposition", at the foot of the middle
                         column. Placed here, the two blocks end up facing each other and the
                         cross-reference is resolved at a glance. Reorder the column and it is
                         lost. -->
                    <TextBlock Text="Default texts" Style="{StaticResource SectionSpaced}"/>

                    <TextBlock Text="MainText" Style="{StaticResource Label}"/>
                    <TextBox Style="{StaticResource BoxSpaced}" Padding="0,0,0,2"
                             Text="{Binding MainText, ElementName=MasterNumericSelector, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="DetailText  (Visible only if ShowDetail=true)" Style="{StaticResource Label}"/>
                    <TextBox Style="{StaticResource BoxSpaced}" Padding="0,0,0,2"
                             Text="{Binding DetailText, ElementName=MasterNumericSelector, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- === Column B: the event, the frame and the layout === -->
                <StackPanel Grid.Column="1" Margin="0,0,20,0">

                    <!-- === The ValueChanged event === -->
                    <Border Width="240" Margin="0,0,0,16"
                            HorizontalAlignment="Left"
                            Background="#FFF0F0F0" BorderBrush="LightGray" BorderThickness="1"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="ValueChanged Events:" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="EventLog" Text="(No changes yet)" FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Border properties" Style="{StaticResource SectionSpaced}" Margin="0,12,0,12"/>

                    <local:BoundedNumericSelector Style="{StaticResource AuxiliarySpaced}" MainText="BorderThickness"
                        ShowDetail="True"
                        DetailText="Thickness of All Borders"
                        Minimum="0" Maximum="8"
                        Value="{Binding BorderThickness, ElementName=MasterNumericSelector, Mode=TwoWay, Converter={StaticResource ThickToInt}}"/>

                    <local:BoundedNumericSelector x:Name="BorderBrushPicker"
                                                  Style="{StaticResource AuxiliarySpaced}"
                                                  ShowDetail="True"
                                                  MainText="BorderBrush"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorIndex}, Mode=OneWay}"
                                                  Minimum="0" Maximum="23" Value="0"
                                                  ValueChanged="BorderBrush_ValueChanged"/>

                    <local:BoundedNumericSelector x:Name="FocusBorderBrushPicker"
                                                  Style="{StaticResource AuxiliarySpaced}"
                                                  ShowDetail="True"
                                                  MainText="FocusBorderBrush"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorIndex}, Mode=OneWay}"
                                                  Minimum="0" Maximum="23" Value="20"
                                                  ValueChanged="FocusBorderBrush_ValueChanged"/>

                    <!-- "Disposition" lives here, and not in the left column with the texts,
                         for two reasons: it shares its nature with "Border properties" —both
                         are geometry— and it balances the height of the three columns. It ends
                         up facing "Default texts", which is what needs ShowDetail. -->
                    <TextBlock Text="Disposition" Style="{StaticResource SectionSpaced}"/>

                    <!-- ShowDetail driven with a numeric selector (0 = false: hides the detail
                         row, 1 = true: shows it), two-way with the Master. -->
                    <local:BoundedNumericSelector Style="{StaticResource AuxiliarySpaced}"
                                                  ShowDetail="True"
                                                  MainText="ShowDetail"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ShowDetailText}, Mode=OneWay}"
                                                  Minimum="0" Maximum="1"
                                                  Value="{Binding ShowDetail, ElementName=MasterNumericSelector, Mode=TwoWay, Converter={StaticResource BoolIndex}}"/>

                    <!-- ValueFollowsDetail driven with a numeric selector (0 = false: keep the
                         value next to the main text, 1 = true: the value follows the detail),
                         two-way with the Master. -->
                    <local:BoundedNumericSelector Style="{StaticResource AuxiliarySpaced}"
                                                  ShowDetail="True"
                                                  MainText="ValueFollowsDetail"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ValueFollowsDetailText}, Mode=OneWay}"
                                                  Minimum="0" Maximum="1"
                                                  Value="{Binding ValueFollowsDetail, ElementName=MasterNumericSelector, Mode=TwoWay, Converter={StaticResource BoolIndex}}"/>

                    <!-- ValueBoxDock driven with a numeric selector (0 = Left, 1 = Right),
                         two-way with the Master; the control's default is Right. -->
                    <local:BoundedNumericSelector Style="{StaticResource AuxiliarySpaced}"
                                                  ShowDetail="True"
                                                  MainText="ValueBoxDock"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ValueBoxDockText}, Mode=OneWay}"
                                                  Minimum="0" Maximum="1"
                                                  Value="{Binding ValueBoxDock, ElementName=MasterNumericSelector, Mode=TwoWay, Converter={StaticResource ValueBoxDockIndex}}"/>

                    <!-- BaseWidth, below ValueBoxDock (same Disposition section). -->
                    <local:BoundedNumericSelector Style="{StaticResource AuxiliarySpaced}" MainText="BaseWidth"
                                                  ShowDetail="True"
                                                  DetailText="Base Width It Grows From"
                                                  Minimum="30" Maximum="800"
                                                  Value="{Binding BaseWidth, ElementName=MasterNumericSelector, Mode=TwoWay}"/>
                </StackPanel>

                <!-- === Column C: colors and typography === -->
                <StackPanel Grid.Column="2">

                    <TextBlock Text="Bar properties" Style="{StaticResource Section}" Margin="0,6,0,6"/>

                    <!-- Six color selectors, one per property the control handles as a brush.
                         Each one hooks its Value (0..23) to a color of the palette and, on
                         change, applies that color to its property on the Master and on itself,
                         so that the change is visible on the control that produced it. The
                         MainText of each says which property it is wired to. -->
                    <local:BoundedNumericSelector x:Name="BarFillPicker"
                                                  Style="{StaticResource Auxiliary}"
                                                  ShowDetail="True"
                                                  MainText="BarFill"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorIndex}, Mode=OneWay}"
                                                  Minimum="0" Maximum="23" Value="9"
                                                  ValueChanged="BarFill_ValueChanged"/>

                    <local:BoundedNumericSelector x:Name="BarDividerBrushPicker"
                                                  Style="{StaticResource Auxiliary}"
                                                  ShowDetail="True"
                                                  MainText="BarDividerBrush"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorIndex}, Mode=OneWay}"
                                                  Minimum="0" Maximum="23" Value="0"
                                                  ValueChanged="BarDividerBrush_ValueChanged"/>

                    <TextBlock Text="Color properties" Style="{StaticResource Section}" Margin="0,6,0,6"/>

                    <local:BoundedNumericSelector x:Name="ForegroundPicker"
                                                  Style="{StaticResource Auxiliary}"
                                                  ShowDetail="True"
                                                  MainText="Foreground"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorIndex}, Mode=OneWay}"
                                                  Minimum="0" Maximum="23" Value="0"
                                                  ValueChanged="Foreground_ValueChanged"/>

                    <!-- MIND the initial Value of every picker: ValueChanged already runs
                         during loading, so the starting index IS APPLIED to the Master. It has
                         to be the color the control comes with by default, or the demo starts
                         out showing something that is not the real appearance of the control.
                         It matters especially here: Background is what shows as the NON-filled
                         part of the bar, and with Transparent (23) the container's background
                         was showing through instead of the control's white. The default is
                         White = 5. -->
                    <local:BoundedNumericSelector x:Name="BackgroundPicker"
                                                  Style="{StaticResource Auxiliary}"
                                                  ShowDetail="True"
                                                  MainText="Background"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorIndex}, Mode=OneWay}"
                                                  Minimum="0" Maximum="23" Value="5"
                                                  ValueChanged="Background_ValueChanged"/>

                    <TextBlock Text="Font properties" Style="{StaticResource Section}"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliary}" MainText="FontSize"
                        Minimum="8" Maximum="40"
                        Value="{Binding FontSize, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector x:Name="FontStylePicker"
                                                  Style="{StaticResource Auxiliary}"
                                                  ShowDetail="True"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource FontStyleIndex}, Mode=OneWay}"
                                                  MainText="FontStyle"
                                                  Minimum="0" Maximum="2"
                                                  ValueChanged="FontStylePicker_ValueChanged"/>

                    <local:BoundedNumericSelector x:Name="FontWeightPicker"
                                                  Style="{StaticResource Auxiliary}"
                                                  ShowDetail="True"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource FontWeightIndex}, Mode=OneWay}"
                                                  MainText="FontWeight"
                                                  Minimum="0" Maximum="4"
                                                  ValueChanged="FontWeightPicker_ValueChanged"/>

                    <!-- Filter for the font list. It is the third text box of the bench and,
                         like the other two, it is there because the data is text and the
                         control is for numbers. Its label goes on the LEFT (the other two carry
                         theirs on top) so that what is a tool of the bench can be told at a
                         glance from what is a property of the control.
                         The interesting part is not the filter: it is that changing it changes
                         the Maximum of the selector below IT WHILE IT IS LIVE, and that is
                         where the re-coercion of Value, ResetValue and the steps shows up,
                         which no other control in this bench exercises. -->
                    <DockPanel Width="240" HorizontalAlignment="Left" Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Text="Font filter:"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="FontFilterBox" Padding="0,0,0,2"
                                 TextChanged="FontFilter_TextChanged"/>
                    </DockPanel>

                    <!-- Last because the height of the selector changes with the font and
                         pushes whatever were below it. -->
                    <local:BoundedNumericSelector x:Name="FontPicker"
                                                  Style="{StaticResource Auxiliary}"
                                                  ShowDetail="True"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource FontIndex}, Mode=OneWay}"
                                                  MainText="FontFamily"
                                                  Minimum="0"
                                                  ValueChanged="FontPicker_ValueChanged"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer: the third row of the Grid was free. The button is there so that the help
             can be discovered without guessing the key; the real gesture is contributed by
             ApplicationCommands.Help. -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="10,6"
                Background="#FFF6FAFD" BorderBrush="#FFBFD4E6" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Help (F1)" Width="90" Padding="0,2"
                        Command="Help"/>
                <TextBlock VerticalAlignment="Center" Foreground="#FF5A6B7A"
                           Text="Every knob in this window is a BoundedNumericSelector driving another one."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
