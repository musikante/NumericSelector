<Window x:Class="NumericSelector.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NumericSelector;assembly=NumericSelector"
        xmlns:test="clr-namespace:NumericSelector.Demo"
        Title="BoundedNumericSelector - Banco de pruebas"
        Height="820"
        Width="1280"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <test:ThicknessToIntConverter x:Key="ThickToInt"/>
        <test:BrushToColorConverter x:Key="BrushToColor"/>
        <test:PropertyIndexToNameConverter x:Key="PropertyIndexToName"/>
        <test:ColorIndexConverter x:Key="ColorIndex"/>
        <test:FontIndexConverter x:Key="FontIndex"/>

        <!-- Paleta para los selectores de color -->
        <x:Array x:Key="Paleta" Type="{x:Type SolidColorBrush}">
            <SolidColorBrush Color="Black"/>
            <SolidColorBrush Color="DimGray"/>
            <SolidColorBrush Color="Gray"/>
            <SolidColorBrush Color="Silver"/>
            <SolidColorBrush Color="LightGray"/>
            <SolidColorBrush Color="White"/>
            <SolidColorBrush Color="DarkRed"/>
            <SolidColorBrush Color="Crimson"/>
            <SolidColorBrush Color="Red"/>
            <SolidColorBrush Color="Orange"/>
            <SolidColorBrush Color="DarkOrange"/>
            <SolidColorBrush Color="Gold"/>
            <SolidColorBrush Color="Yellow"/>
            <SolidColorBrush Color="DarkGreen"/>
            <SolidColorBrush Color="SeaGreen"/>
            <SolidColorBrush Color="Green"/>
            <SolidColorBrush Color="LimeGreen"/>
            <SolidColorBrush Color="Teal"/>
            <SolidColorBrush Color="DarkBlue"/>
            <SolidColorBrush Color="RoyalBlue"/>
            <SolidColorBrush Color="DodgerBlue"/>
            <SolidColorBrush Color="SkyBlue"/>
            <SolidColorBrush Color="Purple"/>
            <SolidColorBrush Color="Transparent"/>
        </x:Array>

        <DataTemplate x:Key="MuestraDeColor">
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="18" Height="12" Fill="{Binding}" Stroke="Gray" StrokeThickness="1"/>
                <TextBlock Text="{Binding Color}" Margin="6,0,0,0" FontFamily="Consolas" FontSize="11"/>
            </StackPanel>
        </DataTemplate>

        <!-- Sin resource de fuentes: el FontPicker enumera el sistema en runtime (FontIndexConverter). -->

        <Style TargetType="TextBlock" x:Key="Etiqueta">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Seccion">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
            <Setter Property="Foreground" Value="#FF20507A"/>
        </Style>
        <!-- Los selectores auxiliares: de una sola línea y de ancho uniforme -->
        <Style TargetType="{x:Type local:BoundedNumericSelector}" x:Key="Auxiliar">
            <Setter Property="Width" Value="240"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="ComboBox" x:Key="Combo">
            <Setter Property="Width" Value="240"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox" x:Key="Caja">
            <Setter Property="Width" Value="240"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ EL SUJETO DE PRUEBA ============ -->
        <TextBlock Grid.Row="0"
                   Text="MasterNumericSelector"
                   FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,8"/>

<!-- ============ GESTOS (40%) + MASTER (60%) ============ -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35*"/>
                <ColumnDefinition Width="65*"/>
            </Grid.ColumnDefinitions>

            <!-- === Gestos a probar sobre el Master (izquierda) === -->
            <Border Grid.Column="0" Margin="0,0,8,0"
                    Background="#FFF0F0F0" BorderBrush="LightGray" BorderThickness="1" Padding="8">
                <StackPanel>
                    <TextBlock Text="Gestos a probar sobre el Master" FontWeight="Bold" Margin="0,0,0,4"
                               Foreground="#FF20507A"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#FF444444" FontSize="11">
                        · Click y arrastre sobre la barra: fija el valor por posición.<LineBreak/>
                        · Botón derecho: 30% izq = mínimo · 50% centro = ResetValue · 50% der = máximo.<LineBreak/>
                        · Rueda del mouse: ±SmallChange, solo con el foco puesto (si no, scrollea el panel).<LineBreak/>
                        · Doble-click en el número: reset. Arrastre vertical sobre el número: ±SmallChange.<LineBreak/>
                        · Teclado: ←/↓/− y →/↑/+ suman y restan SmallChange; RePág/AvPág = ±LargeChange; Inicio = mínimo; Fin = máximo; Supr/Insert = ResetValue.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- === El sujeto de prueba (derecha) === -->
            <Border Grid.Column="1"
                    BorderBrush="#FFBFD4E6" BorderThickness="1"
                    Background="#FFF6FAFD"
                    Padding="5">
                <local:BoundedNumericSelector x:Name="MasterNumericSelector"
                                       ValueChanged="Master_ValueChanged"
                                       ShowDetail="True"
                                       CaptionText="Caption Text Ñ j |"
                                       DetailText="Detail Text Ñ j |"
                                       Minimum="0"
                                       Maximum="100"
                                       Value="50"
                                       ResetValue="50"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- ============ CONTROLES DE PRUEBA ============ -->
        <!-- Va en un ScrollViewer: además de acomodar todo, sirve para probar que la
             rueda del mouse sobre un selector sin foco NO se come el scroll. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- === Columna A: Rango y valor + Textos === -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">

                    <TextBlock Text="Value &amp; range" Style="{StaticResource Seccion}"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" CaptionText="Value"
                        Minimum="{Binding Minimum, ElementName=MasterNumericSelector}"
                        Maximum="{Binding Maximum, ElementName=MasterNumericSelector}"
                        Value="{Binding Value, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" CaptionText="Minimum"
                        Minimum="-1000" Maximum="999"
                        Value="{Binding Minimum, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" CaptionText="Maximum"
                        Minimum="-999" Maximum="1000"
                        Value="{Binding Maximum, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" CaptionText="ResetValue"
                        Minimum="{Binding Minimum, ElementName=MasterNumericSelector}"
                        Maximum="{Binding Maximum, ElementName=MasterNumericSelector}"
                        Value="{Binding ResetValue, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" CaptionText="SmallChange"
                        Minimum="1" Maximum="50"
                        Value="{Binding SmallChange, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" CaptionText="LargeChange"
                        Minimum="1" Maximum="100"
                        Value="{Binding LargeChange, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <TextBlock Text="Texts" Style="{StaticResource Seccion}"/>

                    <TextBlock Text="CaptionText" Style="{StaticResource Etiqueta}"/>
                    <TextBox Style="{StaticResource Caja}" Padding="0,0,0,2"
                             Text="{Binding CaptionText, ElementName=MasterNumericSelector, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="DetailText  (Visible only if ShowDetail=true)" Style="{StaticResource Etiqueta}"/>
                    <TextBox Style="{StaticResource Caja}" Padding="0,0,0,2"
                             Text="{Binding DetailText, ElementName=MasterNumericSelector, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Disposition" Style="{StaticResource Seccion}"/>

                    <CheckBox Content="ShowDetail  (Displays an additional row)" Margin="0,0,0,6"
                              IsChecked="{Binding ShowDetail, ElementName=MasterNumericSelector, Mode=TwoWay}"/>
                    <CheckBox Content="ValueFollowsDetail  (Uncheck to keep with Caption)" Margin="0,0,0,6"
                              IsChecked="{Binding ValueFollowsDetail, ElementName=MasterNumericSelector, Mode=TwoWay}"/>
                    <TextBlock Text="ValueBoxSide  (Sets the Value position)" Style="{StaticResource Etiqueta}"/>
                    <ComboBox Style="{StaticResource Combo}" SelectedValuePath="Content"
                              SelectedValue="{Binding ValueBoxSide, ElementName=MasterNumericSelector, Mode=TwoWay}">
                        <ComboBoxItem Content="{x:Static local:ValueBoxSide.Right}"/>
                        <ComboBoxItem Content="{x:Static local:ValueBoxSide.Left}"/>
                    </ComboBox>
                </StackPanel>

                <!-- === Columna B: Interacción === -->
                <StackPanel Grid.Column="1" Margin="0,0,20,0">

                    <TextBlock Text="ControlBorderPixels" Style="{StaticResource Etiqueta}"/>
                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" CaptionText="Borde (px)"
                        Minimum="0" Maximum="8"
                        Value="{Binding ControlBorderPixels, ElementName=MasterNumericSelector, Mode=TwoWay, Converter={StaticResource ThickToInt}}"/>

                    <TextBlock Text="StretchMode  (AutoGrow: crece para que entre el texto y no vuelve a achicarse)" Style="{StaticResource Etiqueta}" TextWrapping="Wrap"/>
                    <ComboBox Style="{StaticResource Combo}" SelectedValuePath="Content"
                              SelectedValue="{Binding StretchMode, ElementName=MasterNumericSelector, Mode=TwoWay}">
                        <ComboBoxItem Content="{x:Static local:StretchMode.Fixed}"/>
                        <ComboBoxItem Content="{x:Static local:StretchMode.AutoGrow}"/>
                    </ComboBox>

                    <TextBlock Text="Width  (al tocarlo se fija un ancho local: eso anula AutoGrow)" Style="{StaticResource Etiqueta}" TextWrapping="Wrap"/>
                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" CaptionText="Width"
                        Minimum="30" Maximum="800"
                        Value="{Binding Width, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <TextBlock Text="Interacción" Style="{StaticResource Seccion}"/>

                    <TextBlock Text="ValueChangeMode  (MustFocusFirst: hay que darle el foco primero; el click que enfoca no cambia el valor)" Style="{StaticResource Etiqueta}" TextWrapping="Wrap"/>
                    <ComboBox Style="{StaticResource Combo}" SelectedValuePath="Content"
                              SelectedValue="{Binding ValueChangeMode, ElementName=MasterNumericSelector, Mode=TwoWay}">
                        <ComboBoxItem Content="{x:Static local:ValueChangeMode.ChangeOnClick}"/>
                        <ComboBoxItem Content="{x:Static local:ValueChangeMode.MustFocusFirst}"/>
                    </ComboBox>

                    <CheckBox Content="IsReadOnly  (sólo visualización)" Margin="0,0,0,6"
                              IsChecked="{Binding IsReadOnly, ElementName=MasterNumericSelector, Mode=TwoWay}"/>
                    <TextBlock Text="· Conserva el aspecto, pero no responde al mouse ni al teclado y no toma el foco.&#10;· Los cursores pasan a Arrow.&#10;· Seguí moviendo el Value de acá arriba: por código sí cambia."
                               Style="{StaticResource Etiqueta}" TextWrapping="Wrap"
                               Foreground="#FF444444" FontSize="11"/>
                </StackPanel>

                <!-- === Columna C: Colores + Fuente + Gestos === -->
                <StackPanel Grid.Column="2">

                    <TextBlock Text="Color properties" Style="{StaticResource Seccion}"/>

                    <!-- Selector de la propiedad a colorear: elige un índice 0..5 que la
                         próxima utilidad usará como llave para saber qué propiedad del Master
                         pintar. La leyenda muestra el nombre mapeado (solo visual, por ahora). -->
                    <local:BoundedNumericSelector x:Name="PropertyPicker"
                                                  Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource PropertyIndexToName}, Mode=OneWay}"
                                                  CaptionText="Select a property to assign a color"
                                                  Minimum="0" Maximum="5" Value="0"/>

                    <local:BoundedNumericSelector x:Name="ColorPicker"
                                                  Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorIndex}, Mode=OneWay}"
                                                  CaptionText="Select a color for the selected property"
Minimum="0" Maximum="23" Value="21"
                                                   ValueChanged="ColorPicker_ValueChanged"/>

                    <TextBlock Text="Fonts" Style="{StaticResource Seccion}"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" CaptionText="FontSize"
                        Minimum="8" Maximum="40"
                        Value="{Binding FontSize, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <TextBlock Text="FontStyle" Style="{StaticResource Etiqueta}"/>
                    <ComboBox Style="{StaticResource Combo}" SelectedValuePath="Content"
                              SelectedValue="{Binding FontStyle, ElementName=MasterNumericSelector, Mode=TwoWay}">
                        <ComboBoxItem Content="{x:Static FontStyles.Normal}"/>
                        <ComboBoxItem Content="{x:Static FontStyles.Italic}"/>
                        <ComboBoxItem Content="{x:Static FontStyles.Oblique}"/>
                    </ComboBox>

                    <TextBlock Text="FontWeight" Style="{StaticResource Etiqueta}"/>
                    <ComboBox Style="{StaticResource Combo}" SelectedValuePath="Content"
                              SelectedValue="{Binding FontWeight, ElementName=MasterNumericSelector, Mode=TwoWay}">
                        <ComboBoxItem Content="{x:Static FontWeights.Light}"/>
                        <ComboBoxItem Content="{x:Static FontWeights.Normal}"/>
                        <ComboBoxItem Content="{x:Static FontWeights.SemiBold}"/>
                        <ComboBoxItem Content="{x:Static FontWeights.Bold}"/>
                        <ComboBoxItem Content="{x:Static FontWeights.Black}"/>
                    </ComboBox>

                    <!-- Al final porque la altura del selector cambia con la fuente y empuja
                         lo que hubiera debajo. -->
                    <local:BoundedNumericSelector x:Name="FontPicker"
                                                  Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource FontIndex}, Mode=OneWay}"
                                                  CaptionText="FontFamily"
                                                  Minimum="0"
                                                  ValueChanged="FontPicker_ValueChanged"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ============ EVENTO ValueChanged ============ -->
        <Border Grid.Row="3"
                Background="#FFF0F0F0" BorderBrush="LightGray" BorderThickness="1"
                Padding="10">
            <StackPanel>
                <TextBlock Text="Evento ValueChanged" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock x:Name="EventLog" Text="(sin cambios todavía)" FontFamily="Consolas" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
