<Window x:Class="NumericSelector.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NumericSelector;assembly=NumericSelector"
        xmlns:test="clr-namespace:NumericSelector.Demo"
        Title="BoundedNumericSelector - Demonstration &amp; Test Environment"
        Height="820"
        Width="880"
        WindowStartupLocation="CenterScreen">

    <!-- F1 abre la ayuda: ApplicationCommands.Help ya trae ese gesto de fábrica, así que
         alcanza con enlazarlo y no hace falta declarar la tecla en ningún lado. -->
    <Window.CommandBindings>
        <CommandBinding Command="Help" Executed="Help_Executed"/>
    </Window.CommandBindings>

    <Window.Resources>
        <test:ThicknessToIntConverter x:Key="ThickToInt"/>
        <test:ColorIndexConverter x:Key="ColorIndex"/>
        <test:MouseBehaviorIndexConverter x:Key="MouseBehaviorIndex"/>
        <test:MouseBehaviorTextConverter x:Key="MouseBehaviorText"/>
        <test:InteractionModeIndexConverter x:Key="InteractionModeIndex"/>
        <test:InteractionModeTextConverter x:Key="InteractionModeText"/>
        <test:ValueBoxDockIndexConverter x:Key="ValueBoxDockIndex"/>
        <test:ValueBoxDockTextConverter x:Key="ValueBoxDockText"/>
        <!-- Un solo BoolIndex para las dos propiedades booleanas: la conversión es la misma.
             Lo que cambia entre ellas es el texto, y ése sí tiene un converter por propiedad. -->
        <test:BoolIndexConverter x:Key="BoolIndex"/>
        <test:ValueFollowsDetailTextConverter x:Key="ValueFollowsDetailText"/>
        <test:ShowDetailTextConverter x:Key="ShowDetailText"/>
        <test:FontIndexConverter x:Key="FontIndex"/>
        <test:FontStyleIndexConverter x:Key="FontStyleIndex"/>
        <test:FontWeightIndexConverter x:Key="FontWeightIndex"/>

        <!-- Sin resource de colores ni de fuentes: la paleta vive en ColorIndexConverter.Palette
             y las fuentes se enumeran en runtime (FontIndexConverter). Los pickers son
             selectores numéricos por índice, así que no hay lista que declarar en XAML. -->

        <Style TargetType="TextBlock" x:Key="Etiqueta">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Seccion">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
            <Setter Property="Foreground" Value="#FF20507A"/>
        </Style>
        <!-- Los selectores auxiliares: de una sola línea y de un ancho base uniforme.
             BaseWidth es un piso desde el que crecen para acomodar su texto; si el
             contenedor no les da ese hueco, la leyenda se trunca con elipsis. -->
        <Style TargetType="{x:Type local:BoundedNumericSelector}" x:Key="Auxiliar">
            <Setter Property="BaseWidth" Value="240"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox" x:Key="Caja">
            <Setter Property="Width" Value="240"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ EL SUJETO DE PRUEBA (Master) ============ -->
        <Border Grid.Row="0" Margin="0,0,0,12"
                BorderBrush="#FFBFD4E6" BorderThickness="1"
                Background="#FFF6FAFD"
                Padding="5">
            <!-- Los dos textos del Master están escritos así A PROPÓSITO; no "normalizarlos":
                 • empiezan con el nombre exacto de la propiedad, para que se lea tal cual se
                   teclea en código;
                 • "(Interact here)" invita a interactuar sobre esta zona, que es el sujeto de
                   prueba del demo;
                 • "(Vertical extremes: jÑ)" son caracteres de control visual: la j baja del
                   renglón y la Ñ sube con su diacrítico, así que entre las dos ocupan todo el
                   alto de la línea y se ve enseguida si el texto se recorta arriba o abajo al
                   cambiar la fuente o el tamaño.
                 El rótulo de arriba sólo identifica la zona; la invitación no se duplica. -->
            <Grid>
                <TextBlock Text="Master"
                           VerticalAlignment="Top" HorizontalAlignment="Center"
                           FontWeight="Bold" Foreground="#FF20507A"/>
                <local:BoundedNumericSelector x:Name="MasterNumericSelector"
                                          ValueChanged="Master_ValueChanged"
                                          ShowDetail="True"
                                          MainText="MainText (Interact here)"
                                          DetailText="DetailText (Vertical extremes: jÑ)"
                                          Minimum="0"
                                          Maximum="100"
                                          Value="50"
                                          ResetValue="50"
                                          BorderThickness="2"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ============ CONTROLES DE PRUEBA ============ -->
        <!-- Va en un ScrollViewer: además de acomodar todo, sirve para probar que la
             rueda del mouse sobre un selector sin foco NO se come el scroll. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- === Columna A: Rango y valor + Textos === -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">

                    <TextBlock Text="Value &amp; range" Style="{StaticResource Seccion}" Margin="0,6,0,6"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" MainText="Value"
                        Minimum="{Binding Minimum, ElementName=MasterNumericSelector}"
                        Maximum="{Binding Maximum, ElementName=MasterNumericSelector}"
                        Value="{Binding Value, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" MainText="Minimum"
                        Minimum="-1000" Maximum="999"
                        Value="{Binding Minimum, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" MainText="Maximum"
                        Minimum="-999" Maximum="1000"
                        Value="{Binding Maximum, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" MainText="ResetValue"
                        Minimum="{Binding Minimum, ElementName=MasterNumericSelector}"
                        Maximum="{Binding Maximum, ElementName=MasterNumericSelector}"
                        Value="{Binding ResetValue, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" MainText="SmallChange"
                        Minimum="1" Maximum="50"
                        Value="{Binding SmallChange, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" MainText="LargeChange"
                        Minimum="1" Maximum="100"
                        Value="{Binding LargeChange, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <!-- "Default texts": los textos con los que el Master arranca. Escribir en
                         las cajas los reemplaza. -->
                    <TextBlock Text="Default texts" Style="{StaticResource Seccion}"/>

                    <TextBlock Text="MainText" Style="{StaticResource Etiqueta}"/>
                    <TextBox Style="{StaticResource Caja}" Padding="0,0,0,2"
                             Text="{Binding MainText, ElementName=MasterNumericSelector, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="DetailText  (Visible only if ShowDetail=true)" Style="{StaticResource Etiqueta}"/>
                    <TextBox Style="{StaticResource Caja}" Padding="0,0,0,2"
                             Text="{Binding DetailText, ElementName=MasterNumericSelector, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Disposition" Style="{StaticResource Seccion}"/>

                    <!-- El ShowDetail con un selector numérico (0 = false: oculta la fila de
                         detalle, 1 = true: la muestra), dos vías con el Master. -->
                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  MainText="ShowDetail"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ShowDetailText}, Mode=OneWay}"
                                                  Minimum="0" Maximum="1"
                                                  Value="{Binding ShowDetail, ElementName=MasterNumericSelector, Mode=TwoWay, Converter={StaticResource BoolIndex}}"/>

                    <!-- El ValueFollowsDetail con un selector numérico (0 = false: mantener
                         el valor junto al Caption, 1 = true: el valor sigue al detalle),
                         dos vías con el Master. -->
                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  MainText="ValueFollowsDetail"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ValueFollowsDetailText}, Mode=OneWay}"
                                                  Minimum="0" Maximum="1"
                                                  Value="{Binding ValueFollowsDetail, ElementName=MasterNumericSelector, Mode=TwoWay, Converter={StaticResource BoolIndex}}"/>

                    <!-- El ValueBoxDock con un selector numérico (0 = Left, 1 = Right),
                         dos vías con el Master; el default del control es Right. -->
                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  MainText="ValueBoxDock"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ValueBoxDockText}, Mode=OneWay}"
                                                  Minimum="0" Maximum="1"
                                                  Value="{Binding ValueBoxDock, ElementName=MasterNumericSelector, Mode=TwoWay, Converter={StaticResource ValueBoxDockIndex}}"/>

                    <!-- El BaseWidth, debajo de ValueBoxDock (misma sección Disposition). -->
                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" MainText="BaseWidth"
                                                  ShowDetail="True"
                                                  DetailText="Base Width It Grows From"
                                                  Minimum="30" Maximum="800"
                                                  Value="{Binding BaseWidth, ElementName=MasterNumericSelector, Mode=TwoWay}"/>
                </StackPanel>

                <!-- === Columna B: Interacción === -->
                <StackPanel Grid.Column="1" Margin="0,0,20,0">

                    <!-- === Evento ValueChanged === -->
                    <Border Width="240" Margin="0,0,0,8"
                            HorizontalAlignment="Left"
                            Background="#FFF0F0F0" BorderBrush="LightGray" BorderThickness="1"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="ValueChanged Events:" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="EventLog" Text="(No changes yet)" FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Border properties" Style="{StaticResource Seccion}" Margin="0,6,0,6"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" MainText="BorderThickness"
                        ShowDetail="True"
                        DetailText="Thickness of All Borders"
                        Minimum="0" Maximum="8"
                        Value="{Binding BorderThickness, ElementName=MasterNumericSelector, Mode=TwoWay, Converter={StaticResource ThickToInt}}"/>

                    <local:BoundedNumericSelector x:Name="BorderBrushPicker"
                                                  Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  MainText="BorderBrush"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorIndex}, Mode=OneWay}"
                                                  Minimum="0" Maximum="23" Value="0"
                                                  ValueChanged="BorderBrush_ValueChanged"/>

                    <local:BoundedNumericSelector x:Name="FocusBorderBrushPicker"
                                                  Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  MainText="FocusBorderBrush"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorIndex}, Mode=OneWay}"
                                                  Minimum="0" Maximum="23" Value="20"
                                                  ValueChanged="FocusBorderBrush_ValueChanged"/>

                    <TextBlock Text="Interaction properties" Style="{StaticResource Seccion}"/>

                    <!-- El MouseBehavior con un selector numérico (0 = ChangeOnClick,
                         1 = MustFocusFirst), dos vías con el Master. -->
                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  MainText="MouseBehavior"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource MouseBehaviorText}, Mode=OneWay}"
                                                  Minimum="0" Maximum="1"
                                                  Value="{Binding MouseBehavior, ElementName=MasterNumericSelector, Mode=TwoWay, Converter={StaticResource MouseBehaviorIndex}}"/>

                    <!-- El InteractionMode con un selector numérico (0 = Interactive,
                         1 = ReadOnly), dos vías con el Master. En ReadOnly el control
                         conserva el aspecto pero no responde a mouse ni teclado. -->
                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  MainText="InteractionMode"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource InteractionModeText}, Mode=OneWay}"
                                                  Minimum="0" Maximum="1"
                                                  Value="{Binding InteractionMode, ElementName=MasterNumericSelector, Mode=TwoWay, Converter={StaticResource InteractionModeIndex}}"/>
                </StackPanel>

                <!-- === Columna C: Colores + Fuente + Gestos === -->
                <StackPanel Grid.Column="2">

                    <TextBlock Text="Bar properties" Style="{StaticResource Seccion}" Margin="0,6,0,6"/>

                    <!-- Seis selectores de color, uno por cada propiedad que el control
                         maneja como brush. Cada uno engancha su Value (0..23) al color de la
                         paleta y, al cambiar, aplica ese color a su propiedad sobre el Master
                         y sobre sí mismo para que el cambio se aprecie en el control que lo
                         produce. El MainText de cada uno dice a qué propiedad está ligado. -->
                    <local:BoundedNumericSelector x:Name="BarFillPicker"
                                                  Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  MainText="BarFill"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorIndex}, Mode=OneWay}"
                                                  Minimum="0" Maximum="23" Value="9"
                                                  ValueChanged="BarFill_ValueChanged"/>

                    <local:BoundedNumericSelector x:Name="BarDividerBrushPicker"
                                                  Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  MainText="BarDividerBrush"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorIndex}, Mode=OneWay}"
                                                  Minimum="0" Maximum="23" Value="0"
                                                  ValueChanged="BarDividerBrush_ValueChanged"/>

                    <TextBlock Text="Color properties" Style="{StaticResource Seccion}" Margin="0,6,0,6"/>

                    <local:BoundedNumericSelector x:Name="ForegroundPicker"
                                                  Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  MainText="Foreground"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorIndex}, Mode=OneWay}"
                                                  Minimum="0" Maximum="23" Value="0"
                                                  ValueChanged="Foreground_ValueChanged"/>

                    <!-- OJO con el Value inicial de cada picker: el ValueChanged corre ya
                         durante la carga, así que el índice de arranque SE APLICA al Master.
                         Tiene que ser el color que el control trae por defecto, o el demo
                         arranca mostrando algo que no es el aspecto real del control. Acá
                         importa especialmente: Background es lo que se ve como la parte NO
                         rellenada de la barra, y con Transparent (23) se veía el fondo del
                         contenedor en vez del blanco del control. El default es White = 5. -->
                    <local:BoundedNumericSelector x:Name="BackgroundPicker"
                                                  Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  MainText="Background"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorIndex}, Mode=OneWay}"
                                                  Minimum="0" Maximum="23" Value="5"
                                                  ValueChanged="Background_ValueChanged"/>

                    <TextBlock Text="Font properties" Style="{StaticResource Seccion}"/>

                    <local:BoundedNumericSelector Style="{StaticResource Auxiliar}" MainText="FontSize"
                        Minimum="8" Maximum="40"
                        Value="{Binding FontSize, ElementName=MasterNumericSelector, Mode=TwoWay}"/>

                    <local:BoundedNumericSelector x:Name="FontStylePicker"
                                                  Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource FontStyleIndex}, Mode=OneWay}"
                                                  MainText="FontStyle"
                                                  Minimum="0" Maximum="2"
                                                  ValueChanged="FontStylePicker_ValueChanged"/>

                    <local:BoundedNumericSelector x:Name="FontWeightPicker"
                                                  Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource FontWeightIndex}, Mode=OneWay}"
                                                  MainText="FontWeight"
                                                  Minimum="0" Maximum="4"
                                                  ValueChanged="FontWeightPicker_ValueChanged"/>

                    <!-- Filtro de la lista de fuentes. Es la tercera caja de texto del banco y,
                         como las otras dos, está porque el dato es texto y el control es para
                         números. La etiqueta va a la IZQUIERDA (las otras dos la llevan arriba)
                         para distinguir a simple vista lo que es herramienta del banco de lo que
                         es una propiedad del control.
                         Lo interesante no es el filtro: es que al cambiarlo cambia el Maximum del
                         selector de abajo EN CALIENTE, y ahí se ve la re-coerción de Value,
                         ResetValue y los pasos, que ningún otro control de este banco ejercita. -->
                    <DockPanel Width="240" HorizontalAlignment="Left" Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Left" Text="Font filter:"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="FontFilterBox" Padding="0,0,0,2"
                                 TextChanged="FontFilter_TextChanged"/>
                    </DockPanel>

                    <!-- Al final porque la altura del selector cambia con la fuente y empuja
                         lo que hubiera debajo. -->
                    <local:BoundedNumericSelector x:Name="FontPicker"
                                                  Style="{StaticResource Auxiliar}"
                                                  ShowDetail="True"
                                                  DetailText="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource FontIndex}, Mode=OneWay}"
                                                  MainText="FontFamily"
                                                  Minimum="0"
                                                  ValueChanged="FontPicker_ValueChanged"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Pie: la tercera fila del Grid estaba libre. El botón está para que la ayuda se
             descubra sin adivinar la tecla; el gesto real lo aporta ApplicationCommands.Help. -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="10,6"
                Background="#FFF6FAFD" BorderBrush="#FFBFD4E6" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Help (F1)" Width="90" Padding="0,2"
                        Command="Help"/>
                <TextBlock VerticalAlignment="Center" Foreground="#FF5A6B7A"
                           Text="Every knob in this window is a BoundedNumericSelector driving another one."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
