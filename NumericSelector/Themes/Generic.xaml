<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NumericSelector">

    <local:ValueBorderResolver x:Key="ValueBorder" />

    <Style TargetType="{x:Type local:BoundedNumericSelector}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BoundedNumericSelector}">
                    <!-- HIDDEN SIZERS: TextBlocks with Visibility="Hidden" are not drawn but
                         DO take up room in the layout (unlike Collapsed). By putting one with
                         the text of Minimum and another with the text of Maximum in the same
                         cell as the visible value, the cell measures the LARGEST of the three:
                         WPF computes the max() for us and the width ends up reserved for the
                         longest possible number, without depending on the current value (if it
                         did, the column would flinch when going from 99 to 100). -->

                    <!-- THE CONTROL IS INDEPENDENT CELLS, each one with its own frame:
                         (upper row) the bar with its MainText and the value box, and
                         (bottom row, optional) the detail one. None of them is nested inside
                         another, and that is the key: if a cell lived inside a frame wrapping
                         it, its border would stack with the outer one, adding thickness and
                         shifting the edges.
                         WHICH sides each cell draws is resolved by ValueBorderResolver (the
                         "seam matrix"): a MultiBinding returning the Thickness per cell out of
                         ShowDetail, ValueFollowsDetail and ValueBoxDock, so that no edge is
                         drawn twice. -->
                    <Grid x:Name="PART_RootGrid">
                        <Grid.RowDefinitions>
                            <!-- The bar row (upper) absorbs the leftover height: if the
                                 consumer sets a Height larger than the content, the bar
                                 stretches and the bottom border ends up at the edge of the
                                 control, not halfway up. -->
                            <RowDefinition Height="*" x:Name="PART_BarRowDef"/>
                            <!-- Detail row: optional, auto-positioned at the bottom. -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Upper row: the bar with its MainText and the value box to one side.
                             It is the row that is always present, the axis of the control. -->
                        <Grid x:Name="PART_BarAndValueGrid" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <!-- The names are POSITIONAL on purpose: with ValueBoxDock=Left
                                     the cells swap columns, so neither of the two belongs to
                                     the bar or to the value. Naming them after their usual
                                     occupant would make the trigger further below read as the
                                     very mistake it avoids. -->
                                <ColumnDefinition x:Name="PART_Column0" Width="*"/>
                                <ColumnDefinition x:Name="PART_Column1" Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Bar cell: the base frame, it always carries its four sides; its
                                 bottom border also draws the seam with the detail row when
                                 that row exists. MainText (the permanent identifying text) is
                                 drawn over its fill. -->
                            <Border x:Name="PART_BarCell" Grid.Column="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Border.BorderThickness>
                                    <MultiBinding Converter="{StaticResource ValueBorder}" ConverterParameter="Bar">
                                        <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ShowDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueFollowsDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueBoxDock" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.BorderThickness>
                                <Grid x:Name="PART_BarGrid"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      ClipToBounds="True">
                                    <!-- (1) Fill: inside a Canvas on purpose, because the Canvas
                                         measures 0 no matter what its children are, and that way
                                         the width of the rectangle (which the code-behind computes
                                         out of the bar width) does NOT take part in measuring the
                                         content. The fill is decoration: it must size nothing. -->
                                    <Canvas ClipToBounds="True">
                                        <Border x:Name="PART_BarRect"
                                                Background="{TemplateBinding BarFill}"
                                                BorderBrush="{TemplateBinding BarDividerBrush}"
                                                BorderThickness="0,0,1,0"
                                                Width="0"/>
                                    </Canvas>

                                    <!-- (2) MainText: the identifying text of the control, over
                                         the bar fill and centred on it. -->
                                    <TextBlock x:Name="PART_MainText"
                                               Text="{TemplateBinding MainText}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               Padding="0,0,0,1"
                                               Margin="5,0,5,0"/>
                                </Grid>
                            </Border>

                            <!-- Value box next to the bar, below MainText. It gives up the side
                                 facing the bar —that edge is drawn by the bar, which is the base
                                 frame— and carries the other three sides. Its column collapses
                                 and its text is hidden when the value drops to the detail row. -->
                            <Border x:Name="PART_ValueCell" Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Border.BorderThickness>
                                    <MultiBinding Converter="{StaticResource ValueBorder}" ConverterParameter="Value">
                                        <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ShowDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueFollowsDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueBoxDock" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.BorderThickness>
                                <!-- PADDING "3,0,4,1": THE ASYMMETRY IS DELIBERATE, DO NOT EVEN IT OUT.
                                     The extra pixel on the right was decided by LOOKING at the screen:
                                     with the symmetric padding "3,0,3,1" the number looked shifted off
                                     centre, and this one puts it back in place. No formula backs it, so
                                     if someone "normalizes" it to symmetric the defect comes back with
                                     nothing failing and no test complaining.
                                     The THREE TextBlocks —the visible one and the two hidden sizers—
                                     have to share the same value: the sizers are what set the width of
                                     the Auto column, and if they differed, the column would measure
                                     something other than what is drawn. -->
                                <Grid>
                                    <TextBlock x:Name="PART_ValueSizerMin" Visibility="Hidden"
                                               Text="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="3,0,4,1"/>
                                    <TextBlock x:Name="PART_ValueSizerMax" Visibility="Hidden"
                                               Text="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="3,0,4,1"/>
                                    <TextBlock x:Name="PART_ValueText"
                                               Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               Padding="3,0,4,1"
                                               Background="Transparent"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Detail row: below the bar, optional (ShowDetail), with the text of
                             DetailText and, when the value drops, its value box to one side. It
                             starts out collapsed; ShowDetail is what shows it. -->
                        <Grid x:Name="PART_DetailRow" Grid.Row="1" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <!-- Positional, just like the ones in the row above. -->
                                <ColumnDefinition x:Name="PART_DetailColumn0" Width="*"/>
                                <ColumnDefinition x:Name="PART_DetailColumn1" Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Cell of the detail row. A fixed frame that gives up its top side
                                 (the seam with the bar is drawn by the bottom border of the
                                 bar). -->
                            <Border x:Name="PART_DetailCell" Grid.Column="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Border.BorderThickness>
                                    <MultiBinding Converter="{StaticResource ValueBorder}" ConverterParameter="Detail">
                                        <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ShowDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueFollowsDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueBoxDock" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.BorderThickness>
                                <TextBlock x:Name="PART_DetailText"
                                           Text="{TemplateBinding DetailText}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontStyle="{TemplateBinding FontStyle}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch"
                                           Padding="0,0,0,1"
                                           Margin="5,0,5,0"/>
                            </Border>

                            <!-- Value box in the detail row. No border, collapsed by default;
                                 only the value-in-detail trigger lights it up, so that where
                                 this cell shows nothing there is neither a loose stroke nor an
                                 empty gap. -->
                            <Border x:Name="PART_ValueDetailCell" Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0"
                                    Visibility="Collapsed">
                                <!-- Same asymmetric padding "3,0,4,1" as the value box above, for
                                     the same reason and with the same warning (see it there). -->
                                <Grid>
                                    <TextBlock x:Name="PART_DetailSizerMin" Visibility="Hidden"
                                               Text="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="3,0,4,1"/>
                                    <TextBlock x:Name="PART_DetailSizerMax" Visibility="Hidden"
                                               Text="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="3,0,4,1"/>
                                    <TextBlock x:Name="PART_ValueDetailText"
                                               Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               Padding="3,0,4,1"
                                               Background="Transparent"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- ShowDetail: the detail row is shown below the bar. -->
                        <Trigger Property="ShowDetail" Value="True">
                            <Setter TargetName="PART_DetailRow" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Value in detail := ShowDetail and ValueFollowsDetail: the value box
                             drops to the detail row. Up top the bar is left alone, always with
                             its four sides; the upper box is hidden and turns its frame off so
                             as not to leave a loose stroke where there is nothing any more. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowDetail" Value="True"/>
                                <Condition Property="ValueFollowsDetail" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ValueCell" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_ValueText" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_ValueDetailCell" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_ValueDetailText" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_ValueDetailCell" Property="BorderThickness">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource ValueBorder}" ConverterParameter="Value">
                                        <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ShowDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueFollowsDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueBoxDock" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_ValueCell" Property="BorderThickness" Value="0"/>
                        </MultiTrigger>

                        <!-- ValueBoxDock=Left: the value box goes to the left of its row
                             partner, both above (next to the bar) and below (next to the
                             detail). The cells AND the column widths are reordered, because the
                             "*" column has to follow the bar: if only the cells moved, the bar
                             would land in the "Auto" column and shrink to its content, coming
                             away from the edge. -->
                        <Trigger Property="ValueBoxDock" Value="Left">
                            <Setter TargetName="PART_BarCell" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="PART_ValueCell" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="PART_DetailCell" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="PART_ValueDetailCell" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="PART_Column0" Property="Width" Value="Auto"/>
                            <Setter TargetName="PART_Column1" Property="Width" Value="*"/>
                            <Setter TargetName="PART_DetailColumn0" Property="Width" Value="Auto"/>
                            <Setter TargetName="PART_DetailColumn1" Property="Width" Value="*"/>
                        </Trigger>

                        <!-- Focus: the whole outline is tinted with the focus color. There is no
                             "frameless" box to turn off, so the change always applies to every
                             cell. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_BarCell" Property="BorderBrush" Value="{Binding FocusBorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="PART_ValueCell" Property="BorderBrush" Value="{Binding FocusBorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="PART_ValueDetailCell" Property="BorderBrush" Value="{Binding FocusBorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="PART_DetailCell" Property="BorderBrush" Value="{Binding FocusBorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="BaseWidth" Value="300" />
        <!-- No fixed Height: the control sizes itself to its content (compact). -->
        <!-- BaseWidth (not Width): it is a floor it grows from, not a hard width. If the
             container gives less, the control stays within it (borders not clipped) and
             MainText truncates with an ellipsis. WPF's Width/MinWidth would overflow in that
             case. -->
        <Setter Property="Focusable" Value="True" />
        <!-- Without WPF's default dotted rectangle: focus is signalled by the border. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="White"/>
        <!-- MainText and DetailText are NOT set here: their placeholder text —which is the name
             of each property— comes from the metadata of the DP, which is the single source. A
             Setter would win over the metadata and the default would be lost with any
             replacement template. -->
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
