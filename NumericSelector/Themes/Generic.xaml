<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NumericSelector">

    <local:ValueBorderResolver x:Key="ValueBorder" />

    <Style TargetType="{x:Type local:BoundedNumericSelector}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BoundedNumericSelector}">
                    <!-- MEDIDORES OCULTOS ("sizers"): los TextBlock con Visibility="Hidden"
                         no se dibujan pero SÍ ocupan lugar en el layout (a diferencia de
                         Collapsed). Poniendo uno con el texto de Minimum y otro con el de
                         Maximum en la misma celda que el valor visible, la celda mide el
                         MÁXIMO de los tres: WPF calcula el max() por nosotros y el ancho
                         queda reservado para el número más largo posible, sin depender del
                         valor actual (si no, la columna temblaría al pasar de 99 a 100). -->

                    <!-- EL CONTROL SON CUATRO CELDAS INDEPENDIENTES, cada una con su marco:
                         etiqueta del título y caja del valor arriba, barra y caja del valor
                         abajo. Ninguna está anidada dentro de otra, y ésa es la clave: si la
                         caja del valor viviera dentro de un marco que la envuelve, su borde
                         se apilaría con el de afuera, sumando grosor y corriendo los filos.
                         QUÉ lados dibuja cada celda lo resuelve ValueBorderResolver (la
                         "matriz de costuras"): un MultiBinding que devuelve el Thickness por
                         celda según ShowTitle, ValueFollowsTitle y ValueBoxSide, para que
                         ningún filo se dibuje dos veces. -->
                    <Grid x:Name="PART_MainGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- La fila de datos absorbe el alto sobrante: si el consumidor
                                 fija un Height mayor que el contenido, la barra se estira y el
                                 borde inferior queda en el borde del control, no a media altura. -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Fila superior: etiqueta del título y, cuando el valor sube (VBUp),
                             la caja del valor junto a ella. Arranca colapsada (ShowTitle=false
                             es el default); la muestran sus triggers. -->
                        <Grid x:Name="PART_TopRow" Grid.Row="0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="PART_TitleColumn" Width="*"/>
                                <ColumnDefinition x:Name="PART_ValueTopColumn" Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="PART_TitleCell" Grid.Column="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding ControlBorderColor}">
                                <Border.BorderThickness>
                                    <MultiBinding Converter="{StaticResource ValueBorder}" ConverterParameter="Title">
                                        <Binding Path="ControlBorderPixels" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ShowTitle" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueFollowsTitle" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueBoxSide" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.BorderThickness>
                                <TextBlock x:Name="PART_TitleText"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontStyle="{TemplateBinding FontStyle}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Text="{TemplateBinding TitleText}"
TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            Padding="0,0,0,1"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Stretch"
                                            Margin="5,0,5,0"/>
                            </Border>

                            <!-- Caja del valor en la fila superior. Sin borde y colapsada por
                                 defecto; sólo la enciende el trigger de VBUp, para que en las
                                 configuraciones donde esta celda no muestra nada no quede ni
                                 trazo suelto ni un hueco vacío a la derecha del título. -->
                            <Border x:Name="PART_ValueTopCell" Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding ControlBorderColor}"
                                    BorderThickness="0"
                                    Visibility="Collapsed">
                                <Grid>
                                    <TextBlock x:Name="PART_TopSizerMin" Visibility="Hidden"
                                               Text="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="3,0,4,1"/>
                                    <TextBlock x:Name="PART_TopSizerMax" Visibility="Hidden"
                                               Text="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="3,0,4,1"/>
                                    <TextBlock x:Name="PART_ValueWithTitle"
                                               Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
TextAlignment="Center"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                               Padding="3,0,4,1"
                                               Background="Transparent"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="PART_BarAndValueGrid" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" x:Name="PART_BarColumn"/>
                                <ColumnDefinition Width="Auto" x:Name="PART_ValueColumn"/>
                            </Grid.ColumnDefinitions>

                            <!-- Celda de la barra. Cede el lado que toca la caja del valor
                                 según ValueBoxSide; sólo recupera los cuatro lados cuando la
                                 caja sube y la barra queda sola (VBUp). -->
                            <Border x:Name="PART_BarCell" Grid.Column="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding ControlBorderColor}">
                                <Border.BorderThickness>
                                    <MultiBinding Converter="{StaticResource ValueBorder}" ConverterParameter="Bar">
                                        <Binding Path="ControlBorderPixels" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ShowTitle" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueFollowsTitle" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueBoxSide" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.BorderThickness>
                                <Grid x:Name="PART_BarGrid"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      ClipToBounds="True">
                                    <!-- (1) Relleno: en un Canvas a propósito, porque el Canvas
                                         mide 0 sin importar sus hijos y así el ancho del
                                         rectángulo (que el code-behind calcula a partir del ancho
                                         de la barra) NO entra en la medición del contenido. El
                                         relleno es decoración: no debe dimensionar nada. -->
                                    <Canvas ClipToBounds="True">
                                        <Border x:Name="PART_BarRect"
                                                Background="{TemplateBinding BarFillColor}"
                                                BorderBrush="{TemplateBinding BarBorderColor}"
                                                BorderThickness="0,0,1,0"
                                                Width="0"/>
                                    </Canvas>

                                    <!-- (2) Leyenda: encima del relleno, centrada en la barra. -->
                                    <TextBlock x:Name="PART_LegendText"
                                               Text="{TemplateBinding LegendText}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                                Padding="0,0,0,1"
                                                Margin="5,0,5,0"/>
                                </Grid>
                            </Border>

                            <!-- Casillero del valor junto a la barra. Es la celda con
                                 prioridad: lleva los cuatro lados, y su borde contiguo a la
                                 barra es el que separa el número del relleno (la barra cede
                                 ese filo). Su columna se colapsa y su texto se oculta cuando
                                 el valor sube a la fila del título (VBUp). -->
                            <Border x:Name="PART_ValueSideCell" Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding ControlBorderColor}">
                                <Border.BorderThickness>
                                    <MultiBinding Converter="{StaticResource ValueBorder}" ConverterParameter="Value">
                                        <Binding Path="ControlBorderPixels" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ShowTitle" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueFollowsTitle" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueBoxSide" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.BorderThickness>
                                <Grid>
                                    <TextBlock x:Name="PART_ValueSizerMin" Visibility="Hidden"
                                               Text="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="3,0,4,1"/>
                                    <TextBlock x:Name="PART_ValueSizerMax" Visibility="Hidden"
                                               Text="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="3,0,4,1"/>
                                    <!-- Padding asimétrico a propósito (3 izq / 4 der) en el
                                         texto del valor y sus medidores ocultos. El lado
                                         izquierdo más chico compensa el "corrido a la derecha"
                                         que mostraba el padding simétrico, y degrada la diferencia
                                         sub-píxel (~1px) de centrado entre ValueBoxSide=Left/Right
                                         (redondeo de la columna "*"). No tocar el texto sin tocar a
                                         los sizers: ambos miden el ancho de la columna Auto y deben
                                         ser idénticos. -->
                                    <TextBlock x:Name="PART_ValueText"
                                               Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
TextAlignment="Center"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Stretch"
                                               Padding="3,0,4,1"
                                               Background="Transparent"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- ShowTitle: se muestra la fila superior (título enmarcado). -->
                        <Trigger Property="ShowTitle" Value="True">
                            <Setter TargetName="PART_TopRow" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- VBUp := ShowTitle y ValueFollowsTitle: la caja del valor sube a la
                             fila del título. Abajo, la barra queda sola y recupera sus cuatro
                             lados; la caja de abajo se colapsa y apaga su marco para no dejar
                             un trazo suelto donde ya no hay nada. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowTitle" Value="True"/>
                                <Condition Property="ValueFollowsTitle" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ValueSideCell" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_ValueText" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_ValueWithTitle" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_ValueTopCell" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_ValueTopCell" Property="BorderThickness">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource ValueBorder}" ConverterParameter="Value">
                                        <Binding Path="ControlBorderPixels" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ShowTitle" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueFollowsTitle" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueBoxSide" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_ValueSideCell" Property="BorderThickness" Value="0"/>
                        </MultiTrigger>

                        <!-- ValueBoxSide=Left: la caja del valor va a la izquierda de su
                             compañero de fila, tanto abajo (junto a la barra) como arriba
                             (junto al título). Se reordenan las celdas Y los anchos de
                             columna, porque la columna "*" tiene que seguir a la barra:
                             si sólo se movieran las celdas, la barra caería en la columna
                             "Auto" y se encogería a su contenido, despegándose del borde. -->
                        <Trigger Property="ValueBoxSide" Value="Left">
                            <Setter TargetName="PART_BarCell" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="PART_ValueSideCell" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="PART_TitleCell" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="PART_ValueTopCell" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="PART_BarColumn" Property="Width" Value="Auto"/>
                            <Setter TargetName="PART_ValueColumn" Property="Width" Value="*"/>
                            <Setter TargetName="PART_TitleColumn" Property="Width" Value="Auto"/>
                            <Setter TargetName="PART_ValueTopColumn" Property="Width" Value="*"/>
                        </Trigger>

                        <!-- Foco: el contorno completo se tiñe del color de foco. No hay caja
                             "frameless" que apagar, así que el cambio aplica a las cuatro
                             celdas siempre. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_BarCell" Property="BorderBrush" Value="{Binding FocusBorderColor, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="PART_ValueSideCell" Property="BorderBrush" Value="{Binding FocusBorderColor, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="PART_ValueTopCell" Property="BorderBrush" Value="{Binding FocusBorderColor, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="PART_TitleCell" Property="BorderBrush" Value="{Binding FocusBorderColor, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>

                        <!-- En AutoGrow el control se ensancha para que el texto entre, así
                             que recortarlo no tiene sentido. -->
                        <Trigger Property="StretchMode" Value="AutoGrow">
                            <Setter TargetName="PART_LegendText" Property="TextTrimming" Value="None"/>
                            <Setter TargetName="PART_TitleText" Property="TextTrimming" Value="None"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Width" Value="300" />
        <!-- Sin Height fijo: el control se auto-dimensiona a su contenido (compacto). -->
        <Setter Property="Focusable" Value="True" />
        <!-- Sin el recuadro punteado por defecto de WPF: el foco lo indica el borde. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="White"/>
        <Setter Property="TitleText" Value="DefaultTitle" />
        <Setter Property="LegendText" Value="DefaultLegend" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>