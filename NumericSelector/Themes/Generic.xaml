<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NumericSelector">

    <local:ValueBorderResolver x:Key="ValueBorder" />

    <Style TargetType="{x:Type local:BoundedNumericSelector}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BoundedNumericSelector}">
                    <!-- MEDIDORES OCULTOS ("sizers"): los TextBlock con Visibility="Hidden"
                         no se dibujan pero SÍ ocupan lugar en el layout (a diferencia de
                         Collapsed). Poniendo uno con el texto de Minimum y otro con el de
                         Maximum en la misma celda que el valor visible, la celda mide el
                         MÁXIMO de los tres: WPF calcula el max() por nosotros y el ancho
                         queda reservado para el número más largo posible, sin depender del
                         valor actual (si no, la columna temblaría al pasar de 99 a 100). -->

                    <!-- EL CONTROL SON CELDAS INDEPENDIENTES, cada una con su marco:
                         (fila superior) la barra con su Caption y el casillero del valor,
                         y (fila inferior, opcional) la de detalle. Ninguna está anidada
                         dentro de otra, y ésa es la clave: si una celda viviera dentro de
                         un marco que la envuelve, su borde se apilaría con el de afuera,
                         sumando grosor y corriendo los filos.
                         QUÉ lados dibuja cada celda lo resuelve ValueBorderResolver (la
                         "matriz de costuras"): un MultiBinding que devuelve el Thickness por
                         celda según ShowDetail, ValueFollowsCaption y ValueBoxSide, para que
                         ningún filo se dibuje dos veces. -->
                    <Grid x:Name="PART_MainGrid">
                        <Grid.RowDefinitions>
                            <!-- La fila de la barra (superior) absorbe el alto sobrante: si
                                 el consumidor fija un Height mayor que el contenido, la barra
                                 se estira y el borde inferior queda en el borde del control,
                                 no a media altura. -->
                            <RowDefinition Height="*" x:Name="PART_BarRowDef"/>
                            <!-- Fila de detalle: opcional, auto-posicionada abajo. -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Fila superior: la barra con su Caption y el casillero del valor a
                             un lado. Es la fila siempre presente, el eje del control. -->
                        <Grid x:Name="PART_BarAndValueGrid" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="PART_BarColumn" Width="*"/>
                                <ColumnDefinition x:Name="PART_ValueColumn" Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Celda de la barra: marco base, lleva siempre los cuatro
                                 lados; su borde inferior dibuja además la costura con la
                                 fila de detalle cuando existe. Sobre su relleno se dibuja la
                                 Caption (el texto identificador permanente). -->
                            <Border x:Name="PART_BarCell" Grid.Column="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding ControlBorderColor}">
                                <Border.BorderThickness>
                                    <MultiBinding Converter="{StaticResource ValueBorder}" ConverterParameter="Bar">
                                        <Binding Path="ControlBorderPixels" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ShowDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueFollowsDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueBoxSide" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.BorderThickness>
                                <Grid x:Name="PART_BarGrid"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      ClipToBounds="True">
                                    <!-- (1) Relleno: en un Canvas a propósito, porque el Canvas
                                         mide 0 sin importar sus hijos y así el ancho del
                                         rectángulo (que el code-behind calcula a partir del ancho
                                         de la barra) NO entra en la medición del contenido. El
                                         relleno es decoración: no debe dimensionar nada. -->
                                    <Canvas ClipToBounds="True">
                                        <Border x:Name="PART_BarRect"
                                                Background="{TemplateBinding BarFillColor}"
                                                BorderBrush="{TemplateBinding BarBorderColor}"
                                                BorderThickness="0,0,1,0"
                                                Width="0"/>
                                    </Canvas>

                                    <!-- (2) Caption: el texto identificador del control, sobre
                                         el relleno de la barra y centrado en ella. -->
                                    <TextBlock x:Name="PART_CaptionText"
                                               Text="{TemplateBinding CaptionText}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               Padding="0,0,0,1"
                                               Margin="5,0,5,0"/>
                                </Grid>
                            </Border>

                            <!-- Casillero del valor junto a la barra, debajo de la Caption.
                                 Cede el lado que mira a la barra —ese filo lo dibuja la barra,
                                 que es el marco base— y lleva los otros tres lados. Su columna
                                 se colapsa y su texto se oculta cuando el valor desciende a la
                                 fila de detalle. -->
                            <Border x:Name="PART_ValueCell" Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding ControlBorderColor}">
                                <Border.BorderThickness>
                                    <MultiBinding Converter="{StaticResource ValueBorder}" ConverterParameter="Value">
                                        <Binding Path="ControlBorderPixels" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ShowDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueFollowsDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueBoxSide" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.BorderThickness>
                                <Grid>
                                    <TextBlock x:Name="PART_ValueSizerMin" Visibility="Hidden"
                                               Text="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="3,0,4,1"/>
                                    <TextBlock x:Name="PART_ValueSizerMax" Visibility="Hidden"
                                               Text="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="3,0,4,1"/>
                                    <TextBlock x:Name="PART_ValueText"
                                               Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               Padding="3,0,4,1"
                                               Background="Transparent"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Fila de detalle: debajo de la barra, opcional (ShowDetail), con el
                             texto de DetailText y, cuando el valor desciende, su casillero a
                             un lado. Arranca colapsada; la muestra ShowDetail. -->
                        <Grid x:Name="PART_DetailRow" Grid.Row="1" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="PART_DetailColumn" Width="*"/>
                                <ColumnDefinition x:Name="PART_ValueDetailColumn" Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Celda de la fila del detalle. Marco fijo que cede el lado
                                 superior (la costura con la barra la dibuja el borde inferior
                                 de la barra). -->
                            <Border x:Name="PART_DetailCell" Grid.Column="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding ControlBorderColor}">
                                <Border.BorderThickness>
                                    <MultiBinding Converter="{StaticResource ValueBorder}" ConverterParameter="Detail">
                                        <Binding Path="ControlBorderPixels" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ShowDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueFollowsDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueBoxSide" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Border.BorderThickness>
                                <TextBlock x:Name="PART_DetailText"
                                           Text="{TemplateBinding DetailText}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontStyle="{TemplateBinding FontStyle}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch"
                                           Padding="0,0,0,1"
                                           Margin="5,0,5,0"/>
                            </Border>

                            <!-- Casillero del valor en la fila de detalle. Sin borde, colapsado
                                 por defecto; sólo lo enciende el trigger de valor en detalle,
                                 para que donde esta celda no muestra nada no quede ni trazo
                                 suelto ni un hueco vacío. -->
                            <Border x:Name="PART_ValueDetailCell" Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding ControlBorderColor}"
                                    BorderThickness="0"
                                    Visibility="Collapsed">
                                <Grid>
                                    <TextBlock x:Name="PART_DetailSizerMin" Visibility="Hidden"
                                               Text="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="3,0,4,1"/>
                                    <TextBlock x:Name="PART_DetailSizerMax" Visibility="Hidden"
                                               Text="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="3,0,4,1"/>
                                    <TextBlock x:Name="PART_ValueDetailText"
                                               Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               Padding="3,0,4,1"
                                               Background="Transparent"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- ShowDetail: se muestra la fila de detalle debajo de la barra. -->
                        <Trigger Property="ShowDetail" Value="True">
                            <Setter TargetName="PART_DetailRow" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Valor en detalle := ShowDetail y ValueFollowsDetail: la caja del
                             valor desciende a la fila de detalle. Arriba la barra queda sola,
                             siempre con sus cuatro lados; la caja de arriba se oculta y apaga
                             su marco para no dejar un trazo suelto donde ya no hay nada. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowDetail" Value="True"/>
                                <Condition Property="ValueFollowsDetail" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ValueCell" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_ValueText" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_ValueDetailCell" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_ValueDetailText" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_ValueDetailCell" Property="BorderThickness">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource ValueBorder}" ConverterParameter="Value">
                                        <Binding Path="ControlBorderPixels" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ShowDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueFollowsDetail" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ValueBoxSide" RelativeSource="{RelativeSource TemplatedParent}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_ValueCell" Property="BorderThickness" Value="0"/>
                        </MultiTrigger>

                        <!-- ValueBoxSide=Left: la caja del valor va a la izquierda de su
                             compañero de fila, tanto arriba (junto a la barra) como abajo
                             (junto al detalle). Se reordenan las celdas Y los anchos de
                             columna, porque la columna "*" tiene que seguir a la barra:
                             si sólo se movieran las celdas, la barra caería en la columna
                             "Auto" y se encogería a su contenido, despegándose del borde. -->
                        <Trigger Property="ValueBoxSide" Value="Left">
                            <Setter TargetName="PART_BarCell" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="PART_ValueCell" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="PART_DetailCell" Property="Grid.Column" Value="1"/>
                            <Setter TargetName="PART_ValueDetailCell" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="PART_BarColumn" Property="Width" Value="Auto"/>
                            <Setter TargetName="PART_ValueColumn" Property="Width" Value="*"/>
                            <Setter TargetName="PART_DetailColumn" Property="Width" Value="Auto"/>
                            <Setter TargetName="PART_ValueDetailColumn" Property="Width" Value="*"/>
                        </Trigger>

                        <!-- Foco: el contorno completo se tiñe del color de foco. No hay caja
                             "frameless" que apagar, así que el cambio aplica a las celdas
                             siempre. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_BarCell" Property="BorderBrush" Value="{Binding FocusBorderColor, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="PART_ValueCell" Property="BorderBrush" Value="{Binding FocusBorderColor, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="PART_ValueDetailCell" Property="BorderBrush" Value="{Binding FocusBorderColor, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="PART_DetailCell" Property="BorderBrush" Value="{Binding FocusBorderColor, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>

                        <!-- En AutoGrow el control se ensancha para que el texto entre, así
                             que recortarlo no tiene sentido. -->
                        <Trigger Property="StretchMode" Value="AutoGrow">
                            <Setter TargetName="PART_CaptionText" Property="TextTrimming" Value="None"/>
                            <Setter TargetName="PART_DetailText" Property="TextTrimming" Value="None"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Width" Value="300" />
        <!-- Sin Height fijo: el control se auto-dimensiona a su contenido (compacto). -->
        <Setter Property="Focusable" Value="True" />
        <!-- Sin el recuadro punteado por defecto de WPF: el foco lo indica el borde. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="White"/>
        <Setter Property="CaptionText" Value="DefaultCaption" />
        <Setter Property="DetailText" Value="DefaultDetail" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>