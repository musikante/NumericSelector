<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NumericSelector">

    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <local:ThicknessWithoutBottomConverter x:Key="ThicknessWithoutBottom" />
    <local:ThicknessLeftOnlyConverter x:Key="ThicknessLeftOnly" />

    <Style TargetType="{x:Type local:BoundedNumericSelector}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BoundedNumericSelector}">
                    <!-- MEDIDORES OCULTOS ("sizers"): los TextBlock con Visibility="Hidden"
                         no se dibujan pero SÍ ocupan lugar en el layout (a diferencia de
                         Collapsed). Poniendo uno con el texto de Minimum y otro con el de
                         Maximum en la misma celda que el valor visible, la celda mide el
                         MÁXIMO de los tres: WPF calcula el max() por nosotros y el ancho
                         queda reservado para el número más largo posible, sin depender del
                         valor actual (si no, la columna temblaría al pasar de 99 a 100).
                         Ventaja sobre medir a mano: lo mide el mismo motor que lo dibuja,
                         así que reacciona solo a fuente, DPI y cultura. -->
                    <!-- EL CONTROL SON DOS SECCIONES, cada una con su propio marco:
                         la de datos (barra + casillero) con los cuatro lados, y la del
                         título —opcional— con los mismos lados MENOS el inferior. La línea
                         que las separa es el borde SUPERIOR de la sección de datos, que
                         hace doble función: divisor cuando hay título, y borde superior del
                         control cuando no lo hay. Por eso no existe un divisor aparte y el
                         grosor de la separación se lee de ControlBorderPixels.Top, en vez
                         de salir de una reducción arbitraria de los cuatro lados. -->
                    <Grid x:Name="PART_MainGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- La sección de datos absorbe el alto sobrante: si el consumidor
                                 fija un Height mayor que el contenido, la barra se estira y el
                                 borde inferior queda en el borde del control, no a media altura. -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="PART_TitleBorder"
                                Grid.Row="0"
                                BorderBrush="{TemplateBinding ControlBorderColor}"
                                BorderThickness="{Binding Path=ControlBorderPixels, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ThicknessWithoutBottom}}"
                                Background="{TemplateBinding Background}"
                                Visibility="{Binding Path=ShowTitleText, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">

                            <!-- Fila superior: título. En WithTitle comparte la línea con el
                                 valor: el valor reserva su ancho y el título recibe el resto. -->
                            <Grid x:Name="PART_TopRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="PART_TitleText"
                                           Grid.Column="0"
                                           Text="{TemplateBinding TitleText}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontStyle="{TemplateBinding FontStyle}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Padding="1,0,1,1"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch"/>

                                <!-- Celda del valor en la fila superior (modo WithTitle) -->
                                <Grid Grid.Column="1">
                                    <TextBlock x:Name="PART_TopSizerMin" Visibility="Collapsed"
                                               Text="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="4,0,4,1"/>
                                    <TextBlock x:Name="PART_TopSizerMax" Visibility="Collapsed"
                                               Text="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="4,0,4,1"/>
                                    <TextBlock x:Name="PART_ValueWithTitle"
                                               Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               TextAlignment="Right"
                                               Background="Transparent"
                                               Padding="4,0,4,1"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="PART_DataBorder"
                                Grid.Row="1"
                                BorderBrush="{TemplateBinding ControlBorderColor}"
                                BorderThickness="{TemplateBinding ControlBorderPixels}"
                                Background="{TemplateBinding Background}">

                            <Grid x:Name="PART_BarAndValueGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" x:Name="PART_BarColumn"/>
                                    <ColumnDefinition Width="Auto" x:Name="PART_ValueColumn"/>
                                </Grid.ColumnDefinitions>

                                <!-- LA BARRA, en 2 columnas: el valor (si va sobre la barra)
                                     reserva su ancho en la columna Auto y la leyenda recibe
                                     el resto en la columna *. Así no pueden solaparse: la
                                     leyenda se recorta con elipsis antes de llegar al número.
                                     El relleno y la capa clara ocupan AMBAS columnas. -->
                                <!-- Sin Cursor acá: lo fija el code-behind (UpdateCursors),
                                     porque depende del eje, del modo y del foco. -->
                                <Grid Grid.Column="0" x:Name="PART_BarGrid"
                                      VerticalAlignment="Stretch"
                                      Background="Transparent"
                                      ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- (1) Relleno: abarca toda la barra. Va DENTRO de un Canvas
                                         a propósito: el Canvas mide 0 sin importar sus hijos, así
                                         que el ancho del rectángulo (que el code-behind calcula a
                                         partir del ancho de la barra) NO entra en la medición del
                                         contenido. Si entrara, el ancho natural del control
                                         dependería de su propio ancho y en AutoGrow crecería sin
                                         parar. El relleno es decoración: no debe dimensionar nada. -->
                                    <Canvas Grid.ColumnSpan="2" ClipToBounds="True">
                                        <Border x:Name="PART_BarRect"
                                                Background="{TemplateBinding BarFillColor}"
                                                BorderBrush="{TemplateBinding BarBorderColor}"
                                                BorderThickness="0,0,1,0"
                                                Width="0"/>
                                    </Canvas>

                                    <!-- (2) Leyenda: encima del relleno, recibe el espacio restante -->
                                    <TextBlock x:Name="PART_LegendText"
                                               Grid.Column="0"
                                               Text="{TemplateBinding LegendText}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Padding="0,0,0,1"
                                               Margin="10,0,10,0"/>

                                    <!-- (3) Valor sobre la barra: capa base oscura + medidores.
                                         Los medidores pasan a Hidden solo en modo OnBar. -->
                                    <Grid Grid.Column="1">
                                        <TextBlock x:Name="PART_BarSizerMin" Visibility="Collapsed"
                                                   Text="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   FontStyle="{TemplateBinding FontStyle}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   Padding="0,0,0,1"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock x:Name="PART_BarSizerMax" Visibility="Collapsed"
                                                   Text="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   FontStyle="{TemplateBinding FontStyle}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   Padding="0,0,0,1"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock x:Name="PART_ValueOnBarBase"
                                                   Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   FontStyle="{TemplateBinding FontStyle}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Padding="0,0,0,1"
                                                   Margin="0,0,8,0"
                                                   Visibility="Collapsed"/>
                                    </Grid>

                                    <!-- (4) Valor: capa clara recortada al relleno (el Clip lo fija el
                                         code-behind). Abarca AMBAS columnas para que el recorte use el
                                         mismo sistema de coordenadas que la barra. -->
                                    <Grid x:Name="PART_ValueFillLayer" Grid.ColumnSpan="2">
                                        <TextBlock x:Name="PART_ValueOnBarFill"
                                                   Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                                   Foreground="{TemplateBinding FillForeground}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   FontStyle="{TemplateBinding FontStyle}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Padding="0,0,0,1"
                                                   Margin="0,0,8,0"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>

                                <!-- Casillero del valor (modo BesideBar) + sus medidores.
                                     Acá los medidores están siempre Hidden: cuando el valor no
                                     va en el casillero, un trigger fuerza la columna a 0.
                                     El Border aporta el trazo que separa la barra del número.
                                     Sólo el lado izquierdo: los otros tres los pone el marco de
                                     la sección de datos, y volver a dibujarlos daría línea doble.
                                     Arranca en cero y lo enciende el trigger de BesideBar, para
                                     que en los modos donde la columna mide 0 no quede un trazo
                                     vertical huérfano pegado al final de la barra. -->
                                <Border x:Name="PART_ValueBorder"
                                        Grid.Column="1"
                                        BorderBrush="{TemplateBinding ControlBorderColor}"
                                        BorderThickness="0">
                                <Grid>
                                    <TextBlock x:Name="PART_ValueSizerMin" Visibility="Hidden"
                                               Text="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="4,0,4,1"/>
                                    <TextBlock x:Name="PART_ValueSizerMax" Visibility="Hidden"
                                               Text="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Padding="4,0,4,1"/>
                                    <TextBlock x:Name="PART_ValueText"
                                               Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               TextAlignment="Right"
                                               Background="Transparent"
                                               Padding="4,0,4,1"/>
                                </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- BesideBar: el casillero del valor se separa de la barra con un trazo.
                             Va en un trigger del modo, y no fijo en el Border, porque en OnBar y
                             en WithTitle la columna del valor mide 0 y el trazo quedaría suelto. -->
                        <Trigger Property="ValuePlacement" Value="BesideBar">
                            <Setter TargetName="PART_ValueBorder" Property="BorderThickness"
                                    Value="{Binding Path=ControlBorderPixels, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ThicknessLeftOnly}}"/>
                        </Trigger>

                        <!-- Foco: la sección de datos siempre se tiñe, y con ella el trazo que
                             separa la barra del número, que es parte del mismo marco. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_DataBorder" Property="BorderBrush" Value="{Binding FocusBorderColor, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="PART_ValueBorder" Property="BorderBrush" Value="{Binding FocusBorderColor, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>

                        <!-- La del título, sólo si tiene marco. Va como MultiTrigger y no
                             confiando en el orden de declaración: si el marco del título está
                             apagado, el foco no debe encenderlo de sorpresa, y esa regla tiene
                             que estar escrita en la condición, no en la posición del bloque. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True"/>
                                <Condition Property="ShowTitleFrame" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_TitleBorder" Property="BorderBrush" Value="{Binding FocusBorderColor, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </MultiTrigger>

                        <!-- Título sin marco: se apaga lo que se PINTA, no el grosor, así que la
                             geometría queda idéntica y activar o desactivar el modo no mueve nada
                             de lugar. Transparent y NO x:Null: transparente igual pinta, y por eso
                             sigue recibiendo los clics que dan el foco; con nulo la fila del
                             título dejaría de ser alcanzable por el mouse.
                             La independencia respecto del orden está verificada: con este bloque
                             declarado ANTES de los triggers de foco, las pruebas siguen pasando. -->
                        <Trigger Property="ShowTitleFrame" Value="False">
                            <Setter TargetName="PART_TitleBorder" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="PART_TitleBorder" Property="Background" Value="Transparent"/>
                        </Trigger>

                        <!-- OnBar: valor sobre la barra (dos capas) y sus medidores reservando
                             ancho; sin casillero. La barra sigue ocupando todo el ancho. -->
                        <Trigger Property="ValuePlacement" Value="OnBar">
                            <Setter TargetName="PART_ValueColumn" Property="Width" Value="0"/>
                            <Setter TargetName="PART_ValueText" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_ValueOnBarBase" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_ValueOnBarFill" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_BarSizerMin" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_BarSizerMax" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <!-- WithTitle: valor en la línea superior junto al título, con sus medidores.
                             Requiere ShowTitleText. -->
                        <!-- En AutoGrow el control se ensancha para que el texto entre, así
                             que recortarlo no tiene sentido. -->
                        <Trigger Property="StretchMode" Value="AutoGrow">
                            <Setter TargetName="PART_LegendText" Property="TextTrimming" Value="None"/>
                            <Setter TargetName="PART_TitleText" Property="TextTrimming" Value="None"/>
                        </Trigger>
                        <Trigger Property="ValuePlacement" Value="WithTitle">
                            <Setter TargetName="PART_ValueColumn" Property="Width" Value="0"/>
                            <Setter TargetName="PART_ValueText" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_ValueWithTitle" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_TopSizerMin" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_TopSizerMax" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Width" Value="300" />
        <!-- Sin Height fijo: el control se auto-dimensiona a su contenido (compacto).
             Poné Height en la instancia si querés forzar una altura mayor. -->
        <Setter Property="Focusable" Value="True" />
        <!-- Sin el recuadro punteado por defecto de WPF: el foco lo indica el borde. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="White"/>
        <Setter Property="TitleText" Value="DefaultTitle" />
        <Setter Property="LegendText" Value="DefaultLegend" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
