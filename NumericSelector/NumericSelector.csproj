<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<OutputType>Library</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>NumericSelector</AssemblyName>
		<RootNamespace>NumericSelector</RootNamespace>
		<Authors>Jorge Rogelio Zir</Authors>
		<Description>Control WPF para ingresar un valor entero acotado a un rango: no hay forma de obtener un valor fuera de [Minimum, Maximum], así que no hace falta validar la entrada.</Description>
		<Version>0.1.0</Version>
	</PropertyGroup>
</Project>
