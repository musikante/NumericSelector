# Normalizes line endings: always LF in the repository, each platform's own on everybody's
# working disk. Without this, a contributor on another system can produce whole-file diffs
# out of a CRLF-to-LF change.
* text=auto

# Code and markup: text, with a specialized diff where Git offers one.
*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.slnx    text
*.props   text
*.targets text
*.json    text
*.md      text
*.txt     text
*.svg     text

# Binaries: Git should neither normalize them nor show text diffs of them.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary

# Windows files that require CRLF to work.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
